                    end
                end

                local function updateText()
                    if #selectedValues == 0 then
                        selectedText.Text = "Select..."
                    elseif multi then
                        selectedText.Text = table.concat(selectedValues, ", ")
                    else
                        selectedText.Text = selectedValues[1]
                    end
                end

                local optionButtons = {}

                local function createOptions()
                    for _, btn in ipairs(optionButtons) do
                        btn:Destroy()
                    end
                    optionButtons = {}

                    for _, val in ipairs(values) do
                        local optBtn = Utility:Create("TextButton", {
                            Name = val,
                            Parent = optionsFrame,
                            Size = UDim2.new(1, 0, 0, 26),
                            BackgroundColor3 = Theme.Element,
                            BorderSizePixel = 0,
                            Text = val,
                            TextColor3 = table.find(selectedValues, val) and accentColor or Theme.Text,
                            TextSize = 12,
                            Font = table.find(selectedValues, val) and Theme.FontBold or Theme.Font,
                            AutoButtonColor = false
                        })

                        local optCorner = Utility:Create("UICorner", {
                            CornerRadius = UDim.new(0, 4),
                            Parent = optBtn
                        })

                        optBtn.MouseEnter:Connect(function()
                            if not table.find(selectedValues, val) then
                                Utility:Tween(optBtn, {BackgroundColor3 = Theme.ElementHover}, 0.15)
                            end
                        end)

                        optBtn.MouseLeave:Connect(function()
                            if not table.find(selectedValues, val) then
                                Utility:Tween(optBtn, {BackgroundColor3 = Theme.Element}, 0.15)
                            end
                        end)

                        optBtn.MouseButton1Click:Connect(function()
                            if multi then
                                local idx = table.find(selectedValues, val)
                                if idx then
                                    table.remove(selectedValues, idx)
                                    optBtn.TextColor3 = Theme.Text
                                    optBtn.Font = Theme.Font
                                else
                                    table.insert(selectedValues, val)
                                    optBtn.TextColor3 = accentColor
                                    optBtn.Font = Theme.FontBold
                                end
                            else
                                selectedValues = {val}
                                for _, b in ipairs(optionButtons) do
                                    b.TextColor3 = Theme.Text
                                    b.Font = Theme.Font
                                end
                                optBtn.TextColor3 = accentColor
                                optBtn.Font = Theme.FontBold
                            end
                            updateText()
                            dropdownCallback(multi and selectedValues or selectedValues[1])
                        end)

                        table.insert(optionButtons, optBtn)
                    end
                end

                createOptions()

                dropdownBtn.MouseButton1Click:Connect(function()
                    opened = not opened
                    if opened then
                        optionsFrame.Visible = true
                        local totalHeight = math.min(#values * 28 + 8, 150)
                        Utility:Tween(dropdownFrame, {Size = UDim2.new(1, 0, 0, 52 + totalHeight)}, 0.2)
                        Utility:Tween(arrow, {Rotation = 180}, 0.2)
