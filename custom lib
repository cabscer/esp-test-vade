                        end)
                    end
                end)

                local DropdownObj = {}
                function DropdownObj:SetValue(val)
                    if multi then
                        selectedValues = type(val) == "table" and val or {val}
                    else
                        selectedValues = {val}
                    end
                    updateText()
                    createOptions()
                    dropdownCallback(multi and selectedValues or selectedValues[1])
                end
                function DropdownObj:GetValue()
                    return multi and selectedValues or selectedValues[1]
                end
                function DropdownObj:Refresh(newValues, keepSelected)
                    values = newValues
                    if not keepSelected then
                        selectedValues = {}
                    end
                    updateText()
                    createOptions()
                end

                return DropdownObj
            end

