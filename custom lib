function AetherLib:CreateKeySystem(keyOptions)
    keyOptions = keyOptions or {}
    local keyTitle = keyOptions.Title or "Key System"
    local note = keyOptions.Note or "Enter your key to continue"
    local keyCallback = keyOptions.Callback or function() end
    local verifyCallback = keyOptions.VerifyCallback or function(key) return true end

    local parentGui = game.CoreGui or LocalPlayer:WaitForChild("PlayerGui")
    local screenGui = Utility:Create("ScreenGui", {
        Name = "AetherLibKeySystem",
        Parent = parentGui,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        ResetOnSpawn = false
    })

    local blur = Utility:Create("Frame", {
        Name = "Blur",
