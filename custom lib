            Name = "AetherLibNotifications",
            Parent = screenGui,
            ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
            ResetOnSpawn = false
        })
    end

    local notifFrame = Utility:Create("Frame", {
        Name = "Notification",
        Parent = notifGui,
        Size = UDim2.new(0, 320, 0, 80),
        Position = UDim2.new(1, 20, 1, -100),
