        CornerRadius = Theme.CornerRadius,
        Parent = notifFrame
    })

    local stroke = Utility:Create("UIStroke", {
        Color = Theme.Border,
        Thickness = 1,
        Parent = notifFrame
    })

    local accentBar = Utility:Create("Frame", {
        Name = "AccentBar",
        Parent = notifFrame,
        Size = UDim2.new(0, 4, 1, 0),
        BackgroundColor3 = color,
        BorderSizePixel = 0
    })

    local accentCorner = Utility:Create("UICorner", {
        CornerRadius = UDim.new(0, 6),
        Parent = accentBar
    })

    local titleLabel = Utility:Create("TextLabel", {
        Name = "Title",
        Parent = notifFrame,
        Size = UDim2.new(1, -30, 0, 22),
        Position = UDim2.new(0, 16, 0, 10),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = Theme.Text,
        TextSize = 14,
        Font = Theme.FontBold,
        TextXAlignment = Enum.TextXAlignment.Left
    })

    local textLabel = Utility:Create("TextLabel", {
        Name = "Text",
        Parent = notifFrame,
        Size = UDim2.new(1, -30, 0, 40),
        Position = UDim2.new(0, 16, 0, 34),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = Theme.TextDark,
        TextSize = 12,
        Font = Theme.Font,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true
    })

    local closeBtn = Utility:Create("TextButton", {
        Name = "Close",
        Parent = notifFrame,
        Size = UDim2.new(0, 20, 0, 20),
        Position = UDim2.new(1, -25, 0, 8),
        BackgroundTransparency = 1,
        Text = "×",
        TextColor3 = Theme.TextDark,
        TextSize = 18,
        Font = Theme.FontBold
    })

    Utility:Tween(notifFrame, {Position = UDim2.new(1, -340, 1, -100)}, 0.4)

    table.insert(self.ActiveNotifications, notifFrame)
    self:UpdatePositions()

    local function removeNotif()
        if notifFrame.Parent then
            Utility:Tween(notifFrame, {Position = UDim2.new(1, 20, notifFrame.Position.Y.Scale, notifFrame.Position.Y.Offset)}, 0.3)
            task.wait(0.3)
            if notifFrame.Parent then
                notifFrame:Destroy()
            end
            for i, v in ipairs(self.ActiveNotifications) do
                if v == notifFrame then
                    table.remove(self.ActiveNotifications, i)
                    break
                end
            end
            self:UpdatePositions()
        end
    end

    closeBtn.MouseButton1Click:Connect(removeNotif)
    task.delay(duration, removeNotif)

    return notifFrame
end

function NotificationSystem:UpdatePositions()
    for i, notif in ipairs(self.ActiveNotifications) do
        local targetY = -100 - ((i - 1) * (90 + self.Spacing))
        Utility:Tween(notif, {Position = UDim2.new(1, -340, 1, targetY)}, 0.3)
    end
end

