        Parent = keyFrame
    })

    local keyTitleLabel = Utility:Create("TextLabel", {
        Name = "Title",
        Parent = keyFrame,
        Size = UDim2.new(1, 0, 0, 30),
        Position = UDim2.new(0, 0, 0, 15),
        BackgroundTransparency = 1,
        Text = keyTitle,
        TextColor3 = Theme.Text,
        TextSize = 18,
        Font = Theme.FontBold
    })

    local keyNoteLabel = Utility:Create("TextLabel", {
        Name = "Note",
        Parent = keyFrame,
        Size = UDim2.new(1, -40, 0, 20),
        Position = UDim2.new(0, 20, 0, 50),
        BackgroundTransparency = 1,
        Text = note,
        TextColor3 = Theme.TextDark,
        TextSize = 13,
        Font = Theme.Font,
        TextWrapped = true
    })

    local keyInput = Utility:Create("TextBox", {
        Name = "KeyInput",
        Parent = keyFrame,
        Size = UDim2.new(1, -40, 0, 34),
        Position = UDim2.new(0, 20, 0, 85),
        BackgroundColor3 = Theme.Element,
        BorderSizePixel = 0,
        PlaceholderText = "Enter key...",
        PlaceholderColor3 = Theme.TextDark,
        Text = "",
        TextColor3 = Theme.Text,
        TextSize = 13,
        Font = Theme.Font,
        TextXAlignment = Enum.TextXAlignment.Center
    })

    local inputCorner = Utility:Create("UICorner", {
        CornerRadius = UDim.new(0, 6),
        Parent = keyInput
    })

    local submitBtn = Utility:Create("TextButton", {
        Name = "Submit",
        Parent = keyFrame,
        Size = UDim2.new(1, -40, 0, 34),
        Position = UDim2.new(0, 20, 0, 130),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Text = "Submit",
        TextColor3 = Color3.fromRGB(255, 255, 255),
        TextSize = 14,
        Font = Theme.FontBold,
        AutoButtonColor = false
    })

    local submitCorner = Utility:Create("UICorner", {
        CornerRadius = UDim.new(0, 6),
        Parent = submitBtn
    })

    local statusLabel = Utility:Create("TextLabel", {
        Name = "Status",
        Parent = keyFrame,
        Size = UDim2.new(1, 0, 0, 20),
        Position = UDim2.new(0, 0, 0, 172),
        BackgroundTransparency = 1,
        Text = "",
        TextColor3 = Theme.Error,
        TextSize = 12,
        Font = Theme.Font
    })

    submitBtn.MouseEnter:Connect(function()
        Utility:Tween(submitBtn, {BackgroundColor3 = Theme.AccentHover}, 0.2)
    end)

    submitBtn.MouseLeave:Connect(function()
        Utility:Tween(submitBtn, {BackgroundColor3 = Theme.Accent}, 0.2)
    end)

    submitBtn.MouseButton1Click:Connect(function()
        local key = keyInput.Text
        if key == "" then
            statusLabel.Text = "Please enter a key"
            return
        end

        local valid = verifyCallback(key)
        if valid then
            Utility:Tween(blur, {BackgroundTransparency = 1}, 0.3)
            Utility:Tween(keyFrame, {Size = UDim2.new(0, 0, 0, 0)}, 0.3)
            task.delay(0.3, function()
                screenGui:Destroy()
            end)
            keyCallback(key)
        else
            statusLabel.Text = "Invalid key"
            Utility:Tween(keyInput, {BackgroundColor3 = Theme.Error}, 0.1)
            task.delay(0.3, function()
                Utility:Tween(keyInput, {BackgroundColor3 = Theme.Element}, 0.2)
            end)
        end
    end)

    keyInput.Focused:Connect(function()
        statusLabel.Text = ""
    end)
end

