        Name = "KeyFrame",
        Parent = screenGui,
        Size = UDim2.new(0, 350, 0, 200),
        Position = UDim2.new(0.5, -175, 0.5, -100),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0
    })

    local keyCorner = Utility:Create("UICorner", {
